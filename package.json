{
  "name": "career-ops",
  "version": "1.6.0",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "profile": "node agent/commands/profile.mjs",
    "test:target-profile": "node --test agent/test/target-profile.test.mjs agent/test/target-profile-editor.test.mjs",
    "test:discovered-jobs": "node --test agent/test/discovered-jobs.test.mjs",
    "test:matching": "node --test agent/test/matching.test.mjs agent/test/match-command.test.mjs",
    "test:collectors": "node --test agent/test/collectors.test.mjs agent/test/interceptor.test.mjs",
    "test:scheduler": "node --test agent/test/scheduler.test.mjs agent/test/scheduler-systemd.test.mjs",
    "scheduler": "node agent/daemon.mjs",
    "scheduler:status": "node agent/commands/status.mjs",
    "scheduler:systemd": "node agent/commands/scheduler-systemd.mjs",
    "match": "node agent/commands/match.mjs",
    "security:regression": "npm --prefix web run test:security-regression",
    "gemini:eval": "node gemini-eval.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  }
}
