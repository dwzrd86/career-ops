# Browser-visible configuration. VITE_* values are embedded in the client bundle.
VITE_CONVEX_URL=https://your-production-deployment.convex.cloud
VITE_TURNSTILE_SITE_KEY=

# Convex server configuration. Set these in the Convex deployment environment,
# not in Netlify's browser build environment. Values below are intentionally blank.
CONVEX_SITE_URL=https://your-production-deployment.convex.site
SITE_URL=https://app.example.com
AUTH_RESEND_FROM=Jobbie <accounts@example.com>
AUTH_RESEND_KEY=
AUTH_ABUSE_KEY=
ENROLLMENT_INVITE_KEY=
ENROLLMENT_ADMIN_KEY=
AUTH_TURNSTILE_HOSTNAME=app.example.com
AUTH_TURNSTILE_SECRET=
JWT_PRIVATE_KEY=
JWKS=
