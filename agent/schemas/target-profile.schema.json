{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-ops/target-profile.schema.json",
  "title": "Career Ops Target Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "profileVersion",
    "targetRoles",
    "location",
    "compensation",
    "eligibility",
    "preferences",
    "expertise",
    "criteria",
    "evidenceReferences",
    "discovery"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileVersion": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "targetRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "aliases", "priority", "seniority"],
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "priority": { "enum": ["primary", "secondary", "adjacent"] },
          "seniority": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "location": { "type": "object" },
    "compensation": { "type": "object" },
    "eligibility": { "type": "object" },
    "preferences": { "type": "object" },
    "expertise": { "type": "object" },
    "criteria": { "type": "object" },
    "evidenceReferences": { "type": "array" },
    "discovery": {
      "type": "object",
      "properties": {
        "interceptor": {
          "type": "object",
          "required": ["contextId", "allowedSources"],
          "properties": {
            "contextId": { "type": ["string", "null"] },
            "allowedSources": { "type": "array", "items": { "type": "string", "format": "uri" } }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
